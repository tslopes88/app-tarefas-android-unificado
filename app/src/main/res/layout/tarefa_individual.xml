<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/colorCard"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/checkConcluida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/colorSecondary" />

            <TextView
                android:id="@+id/itemNome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Título da Tarefa"
                android:textColor="@color/colorText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemPrioridade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorPriorityMedium"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="MÉDIA"
                android:textColor="@color/colorBackground"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEditarItem"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar tarefa"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/colorSecondary" />

            <ImageButton
                android:id="@+id/btnExcluirItem"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Excluir tarefa"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/colorPriorityHigh" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="2dp"
            android:text="Descrição detalhada..."
            android:textColor="@color/colorTextMuted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/colorSurfaceSecondary"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="📅 31/08/2026"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/itemHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/colorSurfaceSecondary"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="⏰ 14:30"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>